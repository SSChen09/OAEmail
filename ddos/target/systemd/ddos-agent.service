[Unit]
Description=DDoS detect / auto-block / audit panel agent
After=network-online.target nginx.service sshd.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ddos
Environment=DDOS_PANEL=/opt/ddos/index.html
# 关键参数也可在这里覆盖，例如: --ttl 120 --syn-rate 100
ExecStart=/usr/bin/python3 /opt/ddos/agent.py
Restart=always
RestartSec=3
# agent 需�?iptables 与原始套接字
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
